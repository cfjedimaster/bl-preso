dsn = {
	driver:"mysql",
	host:getSystemSetting("MYSQL_HOST"),
	port:getSystemSetting("MYSQL_PORT"),
	database:"golf_league_manager", 
	username:getSystemSetting("MYSQL_USERNAME"),
	password:getSystemSetting("MYSQL_PWORD")	
}; 

users = queryExecute('
	select * from user
	where lastName like :lastName
	order by lastName, firstName asc
', { lastName: '%Stroz%' }, { datasource:dsn });

users.each(u => {
	println("id: #u.id#, last name: #u.lastName#, first name: #u.firstName#");
});
