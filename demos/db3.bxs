dsn = {
	driver:"mysql",
	host:getSystemSetting("MYSQL_HOST"),
	port:getSystemSetting("MYSQL_PORT"),
	database:"golf_league_manager", 
	username:getSystemSetting("MYSQL_USERNAME"),
	password:getSystemSetting("MYSQL_PWORD")	
}; 


users = queryExecute('
	select * from user
	order by lastName, firstName asc
	limit 3
', { }, { datasource:dsn });

users2 = queryExecute('
	select * from user
	order by lastName, firstName asc
	limit 3
', { }, { datasource:dsn, returnType:'array' });

println(jsonPrettify(users.toJSON()));
println('-'.repeat(80));
println(jsonPrettify(users2.toJSON()));
println('-'.repeat(80));
println(jsonPrettify(users.toArrayOfStructs().toJSON()));
